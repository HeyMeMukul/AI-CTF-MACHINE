# CTF sandbox image for engine/envs.DockerEnv.
#
# Build once:
#   docker build -f Dockerfile.kali-ctf -t ctf-kali:latest .
# or:
#   ./scripts/build_image.sh
#
# The image is intentionally a practical core (pwn/rev/crypto/web basics), not a
# full Kali distribution. Add domain tools here and rebuild when needed.
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /work

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip python3-dev \
    binutils gdb strace ltrace socat netcat-openbsd \
    file xxd curl wget git unzip zip jq \
    libgmp-dev libmpfr-dev libmpc-dev libffi-dev libssl-dev \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --no-cache-dir --upgrade pip && \
    pip3 install --no-cache-dir \
    pwntools capstone lief z3-solver pycryptodome gmpy2 sympy

CMD ["bash"]
